# Grok CLI environment variables (optional overrides)
#
# Settings files are the primary configuration source:
# - ~/.grok/user-settings.json
# - <project>/.grok/settings.json
#
# These env vars override settings and are useful for CI/scripts.
# See docs/settings.json.md for the full mapping and defaults.

# Grok API
GROK_API_KEY=your_grok_api_key_here
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-code-fast-1
# GROK_MAX_TOKENS=1536

# UI
# GROK_THEME=vscode-dark-plus

# Morph (optional Fast Apply tool)
# MORPH_API_KEY=your_morph_api_key_here

# RAG embeddings (optional overrides; otherwise uses settings/baseURL defaults)
# GROK_EMBEDDINGS_BASE_URL=https://api.x.ai/v1
# GROK_EMBEDDINGS_MODEL=text-embedding-3-small